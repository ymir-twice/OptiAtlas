+def _prepare_fsdp2_lora_param_dtype(module):
+    """Keep optimizer-owned LoRA shards in FP32; frozen base weights stay unchanged.
+
+    FSDP2 permits frozen and trainable parameters with different original dtypes.
+    Its mixed-precision policy casts only the gathered compute tensors to BF16.
+    """
+    converted = 0
+    trainable_count = 0
+    frozen_dtypes = {}
+    for name, param in module.named_parameters():
+        if not param.requires_grad:
+            key = str(param.dtype)
+            frozen_dtypes[key] = frozen_dtypes.get(key, 0) + 1
+            continue
+        if not param.is_floating_point():
+            raise TypeError(f"FSDP2 LoRA trainable parameter must be floating point: {name}")
+        trainable_count += 1
+        if param.dtype != torch.float32:
+            param.data = param.data.to(torch.float32)
+            converted += 1
+    if not trainable_count:
+        raise ValueError("FSDP2 LoRA model has no trainable parameters")
+    logger.info(
+        "FSDP2 LoRA precision: trainable_tensors=%d trainable_dtype=torch.float32 "
+        "converted_tensors=%d frozen_dtype_counts=%s",
+        trainable_count, converted, frozen_dtypes,
+    )
+    return module
+
